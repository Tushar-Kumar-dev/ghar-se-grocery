# Backend Environment Variables Template
# Copy this to .env for local development

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3306/sibms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Token
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_hs256

# Server Port
PORT=8080

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Spring Active Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev
