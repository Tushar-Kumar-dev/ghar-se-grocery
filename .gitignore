# ==============================================================================
# SIBMS Root .gitignore - Fullstack Enterprise Monorepo
# ==============================================================================

# OS & System Files
.DS_Store
Thumbs.db
Desktop.ini

# Environment Files & Secrets (Never commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Dependencies & Build Directories
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Java & Maven Artifacts
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Crash / Scratch
scratch/
.system_generated/
